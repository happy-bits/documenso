# Environment for the e2e test stack (`docker/testing/compose.yml`).
#
# This file is committed on purpose: a deterministic test run needs a
# checked-in, non-secret configuration rather than whatever happens to be in a
# developer's `.env`.
#
# It is loaded as `dotenv -e .env.test -e .env`. dotenv never overwrites a key
# that is already set, so the FIRST file to define a key wins: everything here
# shadows the development value, and every key absent here falls through to
# `.env`.
#
# The test stack is deliberately port-disjoint from the development stack so
# the two can run side by side and a test run can never touch the database you
# are developing against.
#
#   development: app :3000, postgres :54320
#   testing:     app :3001, postgres :54322

# [[APP]]
# The app under test listens on 3001. NEXT_PUBLIC_WEBAPP_URL must agree with
# the real port — the auth routes reject requests whose Origin header does not
# match it.
PORT=3001
NEXT_PUBLIC_WEBAPP_URL="http://localhost:3001"
NEXT_PRIVATE_INTERNAL_WEBAPP_URL="http://localhost:3001"

# [[DATABASE]]
# `docker/testing/compose.yml` publishes the test Postgres on 54322.
NEXT_PRIVATE_DATABASE_URL="postgres://documenso:password@127.0.0.1:54322/documenso"
NEXT_PRIVATE_DIRECT_DATABASE_URL="postgres://documenso:password@127.0.0.1:54322/documenso"

# [[MAIL]]
# Inbucket in the test stack, on shifted ports.
NEXT_PRIVATE_SMTP_TRANSPORT="smtp-auth"
NEXT_PRIVATE_SMTP_HOST="127.0.0.1"
NEXT_PRIVATE_SMTP_PORT=2510
NEXT_PRIVATE_SMTP_USERNAME="documenso"
NEXT_PRIVATE_SMTP_PASSWORD="password"
NEXT_PRIVATE_SMTP_FROM_NAME="No Reply @ Documenso"
NEXT_PRIVATE_SMTP_FROM_ADDRESS="noreply@documenso.com"

# [[UPLOADS]]
# Store uploads in the database so the test stack needs no S3/MinIO service.
NEXT_PUBLIC_UPLOAD_TRANSPORT="database"

# [[JOBS]]
# Run jobs in-process so the test stack needs no Redis service.
NEXT_PRIVATE_JOBS_PROVIDER="local"

# [[SIGNING]]
# Relative to the app's working directory (`apps/remix`).
NEXT_PRIVATE_SIGNING_TRANSPORT="local"
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH="./example/cert.p12"

# [[TESTS]]
# Rate limiting makes repeated sign-ins from one host non-deterministic.
DANGEROUS_BYPASS_RATE_LIMITS="true"

# The account the e2e suite signs in as. Must match a user created by
# `packages/prisma/seed/initial-seed.ts`.
E2E_TEST_USER_EMAIL="example@documenso.com"
E2E_TEST_USER_PASSWORD="password"
